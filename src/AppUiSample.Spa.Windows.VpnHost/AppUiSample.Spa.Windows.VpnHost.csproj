<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>The Windows sample's VPN host: the VPN service in a process of its own, which the app's service starts at each connect</Description>
		<OutputType>WinExe</OutputType>
		<!-- The head's own, as both executables run from one folder: NuGet then gives them the same build
		     of each package they share. -->
		<TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<!-- The service starts it by this name, which the head records in its own assembly (VhAppVpnHostName). -->
		<AssemblyName>VpnHoodSpaSampleVpnHost</AssemblyName>
		<RootNamespace>AppUiSample.Spa.Windows.VpnHost</RootNamespace>
		<ApplicationIcon>..\AppUiSample.Spa.Windows\Resources\VpnHood.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- The VPN service's side alone; the app's side is the head's. -->
		<PackageReference Include="VpnHood.Core.Client.VpnServices.Host.WindowsTun" Version="$(VhPackageVersion)" />
	</ItemGroup>
</Project>
